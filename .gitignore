# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
# go.work
# go.work.sum

# env file
.env

.idea/
gateway

logs/
**/logs/

key/

# OS specific
.DS_Store
.AppleDouble
.LSOverride
._*
**/._*

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
.trae/
.claude/
.cursorrules
.codex/

# Temp files
tmp/
*.tmp
*.bak
*.log
.gocache/
.artifacts/
dump.lsif
scripts/__pycache__/
scripts/logs/

# Project specific
*.trace
*.png
dtm.bolt
test_assertion.go
.github_token
/data/

# Docs (privacy - project internal documentation)
/docs/

# Compiled binaries
*-srv
*-service
*-binary
/audit
/checkout
/services/coupons/coupons
/services/order/order
/services/checkout/checkout/checkout
/services/gateway/gateway
/services/product/product
/services/users/users
/apis/order/order
/services/checkout/checkout-srv
/services/order/order-srv
